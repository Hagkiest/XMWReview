# 复制为 server/.env 后按需修改（dotenvy 在 main 启动时读取）。
# 开源版只认社区 access-token：界面里粘贴的 token 就是唯一凭证，
# 这里不需要、也不应该填写任何账号、密码或邀请码。

# ---------- 服务监听 ----------
# 部署到服务器 / 宝塔时必须改成 0.0.0.0，否则只在容器或本机内可见。
HOST=127.0.0.1
PORT=8080

# Next.js 静态导出目录；存在时由 Rust 服务同源托管前端。
# 相对路径以 server/ 为基准，构建产物在仓库根的 out/。
STATIC_DIR=../out

# 审核记录、偏好、案件举报时间、值守配置和 qingfeng.log 存放的目录。
# 默认：Windows 用 %LOCALAPPDATA%\QingFeng，其他系统用 $XDG_DATA_HOME/qingfeng
# （没设 XDG_DATA_HOME 时落在系统临时目录）。
# 容器部署建议显式指向挂载出来的卷，例如 ./data。
QF_DATA_DIR=

# ---------- 社区接口 ----------
COMMUNITY_API_BASE=https://community-api.xiaomawang.com/api/v1
# 已审核案件/作品列表使用的接口前缀；留空沿用上一项。
COMMUNITY_JAPI_BASE=

# ---------- 服务器 24 小时值守（自动审核） ----------
# 开源版的值守配置写在 data/auto.json 里，也可以在设置面板中修改并落盘。
# 这里的值只在 auto.json 不存在时作为初始值。
AUTO_ENABLED=false
# 每轮之间的间隔（秒）
AUTO_INTERVAL=90
# 置信度达到阈值才自动提交
AUTO_THRESHOLD=0.9
# 犹豫时优先删除而不是替换
AUTO_PREFER_DELETE=false
# 值守使用的社区 access-token；也可以只在设置面板里填。
AUTO_TOKEN=
# 配置文件位置，留空用 QF_DATA_DIR/auto.json
AUTO_JSON=

# ---------- AI 审核建议（OpenAI 兼容的 Chat Completions） ----------
# 填了地址、模型和至少一个密钥，AI 建议才会启用；否则界面只保留人工审核。
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# 密钥按下列顺序依次尝试，失败（限额、失效、网络异常）自动切到下一个：
#   AI_API_KEY  →  AI_API_KEY_1 ... AI_API_KEY_9  →  AI_API_KEY_FALLBACK  →  AI_API_KEYS
# 每个变量都可以写多个密钥（逗号或空格分隔）；想加密钥直接新增 AI_API_KEY_3、AI_API_KEY_4……
# /api/ai-status 只返回掩码，明文密钥不会离开服务端。
AI_API_KEY=
AI_API_KEY_1=
AI_API_KEY_2=
AI_API_KEY_FALLBACK=
# 也可以把所有密钥写在一行
AI_API_KEYS=
